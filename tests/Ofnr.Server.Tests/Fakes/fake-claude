#!/usr/bin/env bash
# Fake Claude Code CLI: logs args, env and stdin next to $FAKE_LOG (NUL-separated), then prints canned stream-json for $FAKE_SCENARIO.
printf '%s\0' "$@" > "$FAKE_LOG.args"
env -0 > "$FAKE_LOG.env"
cat > "$FAKE_LOG.stdin"

init='{"type":"system","subtype":"init","session_id":"sess-123","claude_code_version":"2.1.311","tools":[],"mcp_servers":[{"name":"ofnr","status":"connected"}]}'
result='{"type":"result","subtype":"success","is_error":false,"result":"done","session_id":"sess-123","total_cost_usd":0.012,"usage":{"input_tokens":100,"output_tokens":20},"permission_denials":[],"structured_output":{"summary":"견적서 초안을 만들었습니다","files":["01_PLAN/OFNR-26031_QUOTE_v01.xlsx"],"needs_confirmation":["단가"],"next_steps":[]}}'

case "${FAKE_SCENARIO:-ok}" in
  auth_error)
    echo "$init"
    echo '{"type":"result","subtype":"success","is_error":true,"api_error_status":401,"terminal_reason":"api_error","result":"Invalid API key. Please run /login","session_id":"sess-123","total_cost_usd":0}'
    exit 1
    ;;
  mcp_failed)
    echo '{"type":"system","subtype":"init","session_id":"sess-123","claude_code_version":"2.1.311","tools":[],"mcp_servers":[{"name":"ofnr","status":"failed"}]}'
    echo "$result"
    ;;
  denials)
    echo "$init"
    echo '{"type":"result","subtype":"success","is_error":false,"result":"done","session_id":"sess-123","total_cost_usd":0.01,"usage":{"input_tokens":10,"output_tokens":2},"permission_denials":[{"tool_name":"Bash","tool_use_id":"tu9","tool_input":{"command":"rm -rf x"}}]}'
    ;;
  *)
    echo "$init"
    echo '{"type":"assistant","message":{"content":[{"type":"text","text":"메일을 분석합니다"},{"type":"tool_use","id":"tu1","name":"mcp__ofnr__get_project","input":{}}]}}'
    echo "$result"
    ;;
esac
