#!/usr/bin/env bash
# Fake Codex CLI: logs args, env and stdin next to $FAKE_LOG (NUL-separated), then prints canned JSONL for $FAKE_SCENARIO.
# The health probes: a version other than the pinned one, and logged out.
case "$*" in
  --version) echo "codex-cli 0.163.0"; exit 0 ;;
  "login status") echo "Not logged in"; exit 1 ;;
esac
printf '%s\0' "$@" > "$FAKE_LOG.args"
env -0 > "$FAKE_LOG.env"
cat > "$FAKE_LOG.stdin"

answer='{"type":"item.completed","item":{"id":"item_2","type":"agent_message","text":"{\"summary\":\"요구사항을 정리했습니다\",\"files\":[],\"needs_confirmation\":[],\"next_steps\":[]}"}}'
usage='{"type":"turn.completed","usage":{"input_tokens":50,"cached_input_tokens":0,"output_tokens":10,"reasoning_output_tokens":0}}'

case "${FAKE_SCENARIO:-ok}" in
  error_events)
    echo '{"type":"thread.started","thread_id":"th-9"}'
    echo '{"type":"turn.started"}'
    echo '{"type":"error","message":"Reconnecting... 1/5"}'
    echo '{"type":"error","message":"Reconnecting... 2/5"}'
    echo "$answer"
    echo "$usage"
    ;;
  turn_failed)
    echo '{"type":"thread.started","thread_id":"th-9"}'
    echo '{"type":"turn.started"}'
    echo '{"type":"error","message":"Reconnecting... 5/5"}'
    echo '{"type":"turn.failed","error":{"message":"stream disconnected before completion"}}'
    exit 1
    ;;
  exit1_empty)
    echo 'Error: required MCP servers failed to initialize: ofnr' >&2
    exit 1
    ;;
  bad_json)
    echo '{"type":"thread.started","thread_id":"th-9"}'
    echo '{"type":"item.completed","item":'
    echo '{"type":"item.started"}'
    echo "$answer"
    echo '{"type":"turn.completed","usage":{"input_tokens":"many"}}'
    ;;
  *)
    echo '{"type":"thread.started","thread_id":"th-9"}'
    echo '{"type":"turn.started"}'
    echo '{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"ls","status":"in_progress"}}'
    echo "$answer"
    echo "$usage"
    ;;
esac
