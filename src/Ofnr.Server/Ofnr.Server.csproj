<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <!-- Keeps EF Core at the Design tool's version in this project and in the tests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Bootstrap copies these into the data root on first run. -->
  <ItemGroup>
    <None Include="../../config/**" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../claude-plugin/**" LinkBase="claude-plugin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../templates/**" LinkBase="templates" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
