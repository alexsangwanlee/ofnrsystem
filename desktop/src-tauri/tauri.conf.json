{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFNR 운영",
  "mainBinaryName": "ofnr-ops",
  "version": "0.1.0",
  "identifier": "kr.co.ofnr.ops",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OFNR 운영",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "OFNR",
    "externalBin": ["binaries/ofnr-server"],
    "resources": {
      "../../config": "config",
      "../../claude-plugin": "claude-plugin"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_CONTENT_OF_ofnr-ops.key.pub",
      "endpoints": ["https://github.com/alexsangwanlee/ofnr-ops-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
